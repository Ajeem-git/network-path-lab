FROM debian:12.9-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends frr nftables iproute2 iputils-ping tcpdump conntrack curl procps \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/router-entrypoint.sh /usr/local/sbin/router-entrypoint.sh
RUN chmod 0755 /usr/local/sbin/router-entrypoint.sh
ENTRYPOINT ["/usr/local/sbin/router-entrypoint.sh"]
